# Copy this file to .env. Never commit .env.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DATA_DIR=./data

# Optional. Use matching test keys first. Set all three to enable checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false

# Optional transactional mail; requires a verified sending domain.
# The public business contact remains smarttutors72@gmail.com.
RESEND_API_KEY=
EMAIL_FROM=

# Only enable if your HTTPS reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
